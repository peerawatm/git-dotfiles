[core]
    	editor = nvim
   	autocrlf = input
    	ignorecase = false
    	hooksPath = ~/.config/git/hooks
	excludesfile = ~/.config/git/ignore
	attributesfile = ~/.config/git/attributes

	# Require https://github.com/dandavison/delta
	pager = delta

[init]
    	defaultBranch = main

[alias]
	sts = status -sb
	a = "!git add -N . && git add -p"
	df = diff
	dfs = diff --staged
	c = commit -v
	l = ls-files
	lg = log --graph --all --abbrev-commit --date=iso --format=format:'%C(yellow)%h%C(auto)%d %C(cyan)[%ad] %C(green)[%G?] %C(magenta)[%an] %C(reset)%s' --shortstat

[commit]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	# allowedSignersFile = ~/.config/ssh/allowed_signers

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictstyle = zdiff3

